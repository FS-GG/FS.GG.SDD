<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FS.GG.SDD.Knowledge</PackageId>
    <Description>Concise Git-backed project findings with shared capture, retrieval and history APIs.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Store.fsi" />
    <Compile Include="Store.fs" />
    <Compile Include="Workspace.fsi" />
    <Compile Include="Workspace.fs" />
    <None Include="*.fsi" Pack="true" PackagePath="api-surface/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
