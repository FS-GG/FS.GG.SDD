<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="FS.GG.SDD.Commands" Version="[2.3.0]" />
    <PackageReference Include="FS.GG.SDD.Artifacts" Version="[2.3.0]" />
    <PackageReference Include="FS.GG.SDD.Knowledge" Version="[2.3.0]" />
    <PackageReference Include="FS.GG.Contracts" Version="[7.6.0]" />
    <PackageReference Include="FS.GG.Governance.Config" Version="[0.3.0]" />
    <PackageReference Include="FS.GG.Audio.Skills" Version="[0.1.0]" />
    <PackageReference Include="FS.GG.Drivers" Version="[0.98.0]" />
    <PackageReference Include="FS.GG.Game.Skills" Version="[0.9.0]" />
    <PackageReference Include="FS.GG.Rendering.Skills" Version="[0.2.0]" />
    <PackageReference Include="FSharp.Core" Version="[10.1.401]" />
    <PackageReference Include="FsQuint" Version="[0.1.0]" />
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
  </ItemGroup>
</Project>
