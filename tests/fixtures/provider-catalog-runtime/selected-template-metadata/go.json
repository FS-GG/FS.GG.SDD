{
  "$schema": "http://json.schemastore.org/template",
  "author": "FS-GG",
  "classifications": [
    "Go",
    "CLI",
    "Workspace"
  ],
  "identity": "FS.GG.Workspace.Go.Cli",
  "name": "FS.GG Go CLI workspace",
  "shortName": "fs-gg-go-cli",
  "preferNameDirectory": true,
  "symbols": {
    "modulePath": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "example.com/fsgg/cli",
      "description": "Required Go module path; preserved exactly, never derived from the display name."
    },
    "lifecycle": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "sdd",
      "choices": [
        {
          "choice": "none"
        },
        {
          "choice": "sdd"
        },
        {
          "choice": "typed-sdd"
        },
        {
          "choice": "spec-kit"
        }
      ]
    },
    "productName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Go CLI product",
      "replaces": "Go CLI product",
      "description": "Raw display name, delivered verbatim in product-name.txt; never interpreted as Go code or module identity."
    },
    "codeIdentifier": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "GoProduct",
      "replaces": "GoProduct",
      "description": "Independent valid exported Go command function identifier; the provider validates it before creation."
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.template.config/**",
        "**/*.filelist",
        "**/*.user",
        "**/dist/**"
      ]
    }
  ]
}
