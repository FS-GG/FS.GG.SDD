{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-gg.github.io/contracts/quint-compiled-contract-q1.schema.json",
  "title": "FS-GG Quint compiled contract Q1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "specification", "sources", "requirements", "actions", "invariants", "evidence", "relations", "verificationProfiles", "bounds", "digests"],
  "properties": {
    "schema": { "const": "fsgg.quint.compiled-contract/q1" },
    "profile": { "const": "fsgg-quint-profile/1" },
    "specification": { "$ref": "#/$defs/id" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "verificationProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "bounds": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "digests": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/digest" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(?:[-.][A-Za-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "startLine", "endLine"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^[^/].*\\.md$" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reads", "writes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reads": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "writes": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "kind", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["requires", "verifiedBy", "implementedBy", "reads", "writes"] },
        "to": { "$ref": "#/$defs/id" }
      }
    }
  }
}
